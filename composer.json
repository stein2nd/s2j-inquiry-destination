{
	"name": "s2j/s2j-inquiry-destination",
	"type": "wordpress-plugin",
	"license": "GPL-3.0-or-later",
	"require": {
		"php": ">=8.3",
		"s2j/inquiry-destination-service": "^0.3.0"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^2.0",
		"phpstan/phpstan": "^2.1",
		"phpstan/phpstan-phpunit": "^2.0",
		"squizlabs/php_codesniffer": "^3.10",
		"wp-coding-standards/wpcs": "^3.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.1",
		"php-stubs/wordpress-stubs": "^6.8"
	},
	"autoload": {
		"psr-4": {
			"S2J\\InquiryDestination\\": "includes/"
		},
		"files": [
			"includes/functions.php"
		]
	},
	"autoload-dev": {
		"psr-4": {
			"S2J\\InquiryDestination\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"test:unit": "@php vendor/bin/phpunit -c phpunit.unit.xml.dist",
		"test": "@test:unit",
		"phpstan": "@php vendor/bin/phpstan analyse -c phpstan.neon.dist --memory-limit=512M",
		"phpcs": "@php vendor/bin/phpcs -p",
		"phpcs:wpcs": "@php vendor/bin/phpcs -p --standard=phpcs.wpcs.xml.dist",
		"phpcbf": "@php vendor/bin/phpcbf",
		"lint:php": [
			"@phpstan",
			"@phpcs",
			"@phpcs:wpcs"
		]
	},
	"config": {
		"sort-packages": true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"platform": {
			"php": "8.3.21"
		}
	}
}
