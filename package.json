{
    "name": "s2j-inquiry-destination",
    "version": "0.1.1",
    "description": "",
    "type": "module",
    "author": "Koutarou ISHIKAWA",
    "license": "GPL-3.0-or-later",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/stein2nd/s2j-inquiry-destination.git"
    },
    "homepage": "https://github.com/stein2nd/s2j-inquiry-destination#readme",
    "bugs": {
        "url": "https://github.com/stein2nd/s2j-inquiry-destination/issues"
    },
    "keywords": [
        "wordpress",
        "plugin",
        "gutenberg",
        "blocks",
        "management"
    ],
    "main": "s2j-inquiry-destination.php",
    "scripts": {
        "lint:docs": "s2j-docs-linter ./README.md ./CHANGELOG.md ./docs/**/*.md ./docs_mod/**/*.md",
        "lint": "npm run lint:ts && npm run lint:scss",
        "lint:fix": "npm run lint:ts:fix && npm run lint:scss:fix",
        "lint:ts": "eslint src tools --ext .ts,.tsx --no-error-on-unmatched-pattern",
        "lint:ts:fix": "eslint src tools --ext .ts,.tsx --fix --no-error-on-unmatched-pattern",
        "lint:scss": "stylelint \"src/**/*.scss\" --allow-empty-input",
        "lint:scss:fix": "stylelint \"src/**/*.scss\" --fix --allow-empty-input",
        "lint:php": "composer lint:php",
        "phpstan": "composer phpstan",
        "phpcs": "composer phpcs",
        "phpcs:wpcs": "composer phpcs:wpcs",
        "test:unit:php:local": "composer test",
        "build:assets": "node tools/dist/ensure-dist-assets.mjs",
        "build:dev": "FLUSH_DIST=true npm run build:assets",
        "build:production": "FLUSH_DIST=true npm run build:assets",
        "makepot": "wp i18n make-pot . languages/s2j-inquiry-destination.pot --domain=s2j-inquiry-destination",
        "makemo": "wp i18n make-mo languages",
        "makejson": "wp i18n make-json languages",
        "makejson:keep": "wp i18n make-json languages --no-purge",
        "makei18n": "npm run makemo && npm run makejson",
        "dist:build": "composer install --no-dev --optimize-autoloader --no-interaction && node tools/dist/ensure-dist-assets.mjs",
        "dist:zip": "node tools/dist/make-dist-zip.mjs",
        "dist": "npm run dist:build && npm run dist:zip",
        "dev": "npm run build:dev",
        "pretest:unit:php:local": "composer install --no-interaction --prefer-dist",
        "pretest:lint:php": "composer install --no-interaction --prefer-dist",
        "prelint:php": "composer install --no-interaction --prefer-dist",
        "prephpstan": "composer install --no-interaction --prefer-dist",
        "prephpcs": "composer install --no-interaction --prefer-dist",
        "prephpcs:wpcs": "composer install --no-interaction --prefer-dist",
        "predist:build": "composer install --no-interaction --prefer-dist"
    },
    "dependencies": {
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    },
    "overrides": {
        "rollup": "^4.65.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@s2j/docs-linter": "^1.0.30",
        "@types/jquery": "^4.0.1",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@typescript-eslint/eslint-plugin": "^8.72.0",
        "@typescript-eslint/parser": "^8.72.0",
        "@typescript/native": "npm:typescript@^7.0.2",
        "@wordpress/api-fetch": "^8.0.0",
        "@wordpress/block-editor": "^19.0.0",
        "@wordpress/blocks": "^17.0.0",
        "@wordpress/components": "^43.0.0",
        "@wordpress/data": "^11.0.0",
        "@wordpress/element": "^10.0.0",
        "@wordpress/i18n": "^7.0.0",
        "@wordpress/url": "^5.0.0",
        "autoprefixer": "^10.6.1",
        "eslint": "^10.13.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "rollup": "^4.65.0",
        "sass": "^1.106.1",
        "stylelint": "^17.16.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "vite": "^8.3.5",
        "vite-plugin-static-copy": "^4.1.1"
    },
    "allowScripts": {
        "@s2j/docs-linter": true,
        "fsevents": true,
        "@parcel/watcher": true
    }
}
