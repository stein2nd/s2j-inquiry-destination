#. Plugin URI of the plugin
#: s2j-inquiry-destination.php
msgid "https://github.com/stein2nd/s2j-inquiry-destination"
msgstr "https://github.com/stein2nd/s2j-inquiry-destination"

#. Description of the plugin
#: s2j-inquiry-destination.php
msgid ""
"Route Snow Monkey Forms administrator mail through inquiry-type destinations "
"(mail or inquiry-management SaaS)."
msgstr ""
"Snow Monkey Forms の管理者宛てメールを、inquiry-type の配信先 (メールまたは問"
"い合わせ管理用 SaaS) 経由で転送します。"

#. Author of the plugin
#: s2j-inquiry-destination.php
msgid "Koutarou ISHIKAWA"
msgstr "Koutarou ISHIKAWA"

